#!/usr/bin/python3
"""Show a macOS notification when the main Codex thread stops."""

import json
import os
from pathlib import Path
import subprocess
import sys


def thread_name(session_id: str) -> str:
    codex_home = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex")))
    index = codex_home / "session_index.jsonl"
    try:
        for line in index.read_text(encoding="utf-8").splitlines():
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            name = entry.get("thread_name")
            if entry.get("id") == session_id and isinstance(name, str) and name:
                return name
    except OSError:
        pass
    return "Codex"


def main() -> int:
    try:
        hook = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return 0

    if hook.get("hook_event_name") != "Stop":
        return 0

    session_id = hook.get("session_id")
    if not isinstance(session_id, str):
        return 0

    title = thread_name(session_id)
    message = hook.get("last_assistant_message")
    if not isinstance(message, str) or not message.strip():
        message = "任务已完成"
    else:
        message = " ".join(message.split())[:240]

    subprocess.run(
        [
            "/usr/bin/osascript",
            "-e",
            "on run argv",
            "-e",
            'display notification (item 2 of argv) with title (item 1 of argv)',
            "-e",
            "end run",
            title,
            message,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        if os.environ.get("CODEX_NOTIFY_DEBUG") == "1":
            print(f"codex-stop-notify: {error}", file=sys.stderr)
        raise SystemExit(0)
