{
 :profiles {
            :Default {
                      :default true
                      :sim     50
                      :delay   50
                      :alone   180
                      :held    300
                      }
            }

 :main [
  {:des "Caps tap -> Esc, hold -> Left Control"
    :rules [
            [:caps_lock :left_control nil { :alone :escape }]
            [:!Scaps_lock :!Sleft_control]
            ]}
  {:des "Left Control -> Caps Lock"
    :rules [
            [:!S##left_control :!Scaps_lock]
            [:!R##left_control :!Rcaps_lock]
            [:!C##left_control :!Ccaps_lock]
            [:!Q##left_control :!Qcaps_lock]
            [:!O##left_control :!Ocaps_lock]
            [:!E##left_control :!Ecaps_lock]
            [:!T##left_control :!Tcaps_lock]
            [:!W##left_control :!Wcaps_lock]
            [:!F##left_control :!Fcaps_lock]
            [:left_control :caps_lock]
            ]}
  {:des "Right Option + j/i/k/l -> Left/Up/Down/Right"
    :rules [
            [:!Ej :left_arrow]
            [:!Ei :up_arrow]
            [:!Ek :down_arrow]
            [:!El :right_arrow]
            ]}
  ]
 }
